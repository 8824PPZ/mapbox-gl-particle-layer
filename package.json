{
  "name": "mapbox-gl-particle-layer",
  "version": "0.1.0",
  "description": "GPU wind / flow particle layer for Mapbox GL JS and MapLibre GL JS, implemented as a single custom layer.",
  "keywords": [
    "mapbox",
    "maplibre",
    "mapbox-gl",
    "maplibre-gl",
    "webgl",
    "particles",
    "wind",
    "flow",
    "custom-layer",
    "visualization"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "wind": "node scripts/generate-wind.mjs",
    "preview": "vite preview --port 4173"
  },
  "peerDependencies": {
    "mapbox-gl": ">=2.15.0",
    "maplibre-gl": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "mapbox-gl": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.9",
    "eslint": "^9.13.0",
    "mapbox-gl": "^3.7.0",
    "maplibre-gl": "^4.7.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
